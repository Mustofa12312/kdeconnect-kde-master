#!/usr/bin/env python3
"""
kdeconnect-prompt: Synchronized Dual-Screen Remote & Desktop Authorization Prompt
Displays interactive approval card on BOTH Android phone (Apple Dynamic Island)
and Desktop screen simultaneously. Tapping on either one dismisses both and proceeds!
"""

import sys
import os
import argparse
import time

try:
    import dbus
    from dbus.mainloop.glib import DBusGMainLoop
    from gi.repository import GLib
except ImportError:
    pass


def parse_arguments():
    parser = argparse.ArgumentParser(description="KDE Connect Dual-Screen Authorization Prompt")
    parser.add_argument("--title", "-t", default="Antigravity Authorization", help="Prompt title")
    parser.add_argument("--body", "-b", required=True, help="Prompt message or command snippet")
    parser.add_argument("--actions", "-a", nargs="+", default=[
        "1:Yes, allow this time",
        "2:Yes, and always allow",
        "3:No"
    ], help="Action options format key:label")
    parser.add_argument("--device", "-d", default=None, help="Specific device ID")
    parser.add_argument("--timeout", type=int, default=15, help="Timeout in seconds")
    return parser.parse_args()


def find_target_device(bus, requested_device_id=None):
    try:
        daemon_obj = bus.get_object("org.kde.kdeconnect", "/modules/kdeconnect")
        daemon_iface = dbus.Interface(daemon_obj, "org.kde.kdeconnect.daemon")
        devices = daemon_iface.devices(True, True)
    except Exception as e:
        sys.stderr.write(f"Cannot query KDE Connect daemon: {e}\n")
        return None

    if not devices:
        return None

    for dev in devices:
        dev_id = str(dev)
        if requested_device_id and dev_id != requested_device_id:
            continue
        try:
            obj = bus.get_object("org.kde.kdeconnect", f"/modules/kdeconnect/devices/{dev_id}")
            props = dbus.Interface(obj, "org.freedesktop.DBus.Properties")
            is_reachable = bool(props.Get("org.kde.kdeconnect.device", "isReachable"))
            if is_reachable:
                # Ensure sendnotifications plugin is enabled
                dev_iface = dbus.Interface(obj, "org.kde.kdeconnect.device")
                if not dev_iface.isPluginEnabled("kdeconnect_sendnotifications"):
                    dev_iface.setPluginEnabled("kdeconnect_sendnotifications", True)
                return dev_id
        except Exception:
            continue

    return None


def main():
    args = parse_arguments()

    DBusGMainLoop(set_as_default=True)
    try:
        bus = dbus.SessionBus()
    except Exception as e:
        sys.stderr.write(f"Error connecting to session bus: {e}\n")
        return 1

    # Flatten actions into [key, label, key, label...]
    flattened_actions = []
    for item in args.actions:
        if ":" in item:
            k, v = item.split(":", 1)
            flattened_actions.extend([k.strip(), v.strip()])
        else:
            flattened_actions.extend([item.strip(), item.strip()])

    loop = GLib.MainLoop()
    result = {"action": None, "timed_out": False}

    phone_prompt_id = None
    desktop_notif_id = None
    desktop_iface = None

    # Get desktop notification interface
    try:
        notif_obj = bus.get_object("org.freedesktop.Notifications", "/org/freedesktop/Notifications")
        desktop_iface = dbus.Interface(notif_obj, "org.freedesktop.Notifications")
    except Exception:
        pass

    def cleanup_desktop_notification():
        if desktop_iface and desktop_notif_id:
            try:
                desktop_iface.CloseNotification(dbus.UInt32(desktop_notif_id))
            except Exception:
                pass

    def on_phone_action(action_id, action_key):
        if phone_prompt_id is None or str(action_id) == str(phone_prompt_id):
            result["action"] = str(action_key)
            cleanup_desktop_notification()
            loop.quit()

    def on_desktop_action(nid, action_key):
        if desktop_notif_id is not None and int(nid) == int(desktop_notif_id):
            result["action"] = str(action_key)
            cleanup_desktop_notification()
            loop.quit()

    # 1. Post to phone via KDE Connect if device reachable
    device_id = find_target_device(bus, args.device)
    if device_id:
        bus.add_signal_receiver(
            on_phone_action,
            signal_name="actionInvoked",
            dbus_interface="org.kde.kdeconnect.device.sendnotifications",
            path=f"/modules/kdeconnect/devices/{device_id}/sendnotifications"
        )
        try:
            sendnotif_obj = bus.get_object("org.kde.kdeconnect", f"/modules/kdeconnect/devices/{device_id}/sendnotifications")
            sendnotif_iface = dbus.Interface(sendnotif_obj, "org.kde.kdeconnect.device.sendnotifications")
            phone_prompt_id = str(sendnotif_iface.sendPrompt(args.title, args.body, flattened_actions))
        except Exception as e:
            sys.stderr.write(f"Could not send prompt to phone: {e}\n")

    # 2. ALSO post interactive notification on laptop desktop screen simultaneously!
    if desktop_iface:
        bus.add_signal_receiver(
            on_desktop_action,
            signal_name="ActionInvoked",
            dbus_interface="org.freedesktop.Notifications"
        )
        try:
            hints = {
                "urgency": dbus.Byte(2),
                "category": "device.authorization",
                "x-kdeconnect-source-device": dbus.Boolean(True)  # prevents echo loop
            }
            desktop_notif_id = int(desktop_iface.Notify(
                "Antigravity",
                dbus.UInt32(0),
                "security-high",
                args.title,
                args.body,
                flattened_actions,
                hints,
                dbus.Int32(args.timeout * 1000)
            ))
        except Exception as e:
            sys.stderr.write(f"Could not show desktop notification: {e}\n")

    # If neither phone nor desktop could be posted, fail to fallback
    if not phone_prompt_id and not desktop_notif_id:
        return 3

    # Setup timeout
    def on_timeout():
        result["timed_out"] = True
        cleanup_desktop_notification()
        loop.quit()
        return False

    GLib.timeout_add_seconds(args.timeout, on_timeout)

    try:
        loop.run()
    except KeyboardInterrupt:
        cleanup_desktop_notification()
        return 130

    cleanup_desktop_notification()

    if result["timed_out"]:
        return 4

    if result["action"]:
        print(result["action"])
        return 0

    return 5


if __name__ == "__main__":
    sys.exit(main())
