#!/usr/bin/env python3
"""
kdeconnect-prompt: Send interactive authorization prompt to paired phone via KDE Connect
and wait for user selection.
"""

import sys
import os
import argparse
import time

try:
    import dbus
    from dbus.mainloop.glib import DBusGMainLoop
    from gi.repository import GLib
except ImportError:
    pass


def parse_arguments():
    parser = argparse.ArgumentParser(description="KDE Connect Remote Authorization Prompt")
    parser.add_argument("--title", "-t", default="Antigravity Authorization", help="Prompt title")
    parser.add_argument("--body", "-b", required=True, help="Prompt message or command snippet")
    parser.add_argument("--actions", "-a", nargs="+", default=[
        "1:Yes, allow this time",
        "2:Yes, and always allow",
        "3:No"
    ], help="Action options format key:label")
    parser.add_argument("--device", "-d", default=None, help="Specific device ID")
    parser.add_argument("--timeout", type=int, default=60, help="Timeout in seconds")
    return parser.parse_args()


def find_target_device(bus, requested_device_id=None):
    try:
        daemon_obj = bus.get_object("org.kde.kdeconnect", "/modules/kdeconnect")
        daemon_iface = dbus.Interface(daemon_obj, "org.kde.kdeconnect.daemon")
        devices = daemon_iface.devices(True, True)
    except Exception as e:
        sys.stderr.write(f"Cannot query KDE Connect daemon: {e}\n")
        return None

    if not devices:
        return None

    for dev in devices:
        dev_id = str(dev)
        if requested_device_id and dev_id != requested_device_id:
            continue
        try:
            obj = bus.get_object("org.kde.kdeconnect", f"/modules/kdeconnect/devices/{dev_id}")
            props = dbus.Interface(obj, "org.freedesktop.DBus.Properties")
            is_reachable = bool(props.Get("org.kde.kdeconnect.device", "isReachable"))
            if is_reachable:
                # Ensure sendnotifications plugin is enabled
                dev_iface = dbus.Interface(obj, "org.kde.kdeconnect.device")
                if not dev_iface.isPluginEnabled("kdeconnect_sendnotifications"):
                    dev_iface.setPluginEnabled("kdeconnect_sendnotifications", True)
                return dev_id
        except Exception:
            continue

    return None


def main():
    args = parse_arguments()

    DBusGMainLoop(set_as_default=True)
    try:
        bus = dbus.SessionBus()
    except Exception as e:
        sys.stderr.write(f"Error connecting to session bus: {e}\n")
        return 1

    device_id = find_target_device(bus, args.device)
    if not device_id:
        sys.stderr.write("No reachable paired KDE Connect device found.\n")
        return 2

    # Flatten actions into [key, label, key, label...]
    flattened_actions = []
    for item in args.actions:
        if ":" in item:
            k, v = item.split(":", 1)
            flattened_actions.extend([k.strip(), v.strip()])
        else:
            flattened_actions.extend([item.strip(), item.strip()])

    loop = GLib.MainLoop()
    result = {"action": None, "timed_out": False}

    prompt_id_holder = [None]

    def on_action_invoked(action_id, action_key):
        if prompt_id_holder[0] is None or str(action_id) == str(prompt_id_holder[0]):
            result["action"] = str(action_key)
            loop.quit()

    # Listen on KDE Connect sendnotifications D-Bus interface
    bus.add_signal_receiver(
        on_action_invoked,
        signal_name="actionInvoked",
        dbus_interface="org.kde.kdeconnect.device.sendnotifications",
        path=f"/modules/kdeconnect/devices/{device_id}/sendnotifications"
    )

    # Also listen on standard Freedesktop ActionInvoked as fallback
    bus.add_signal_receiver(
        on_action_invoked,
        signal_name="ActionInvoked",
        dbus_interface="org.freedesktop.Notifications"
    )

    # Attempt to send prompt via KDE Connect sendnotifications interface
    sent = False
    try:
        sendnotif_obj = bus.get_object("org.kde.kdeconnect", f"/modules/kdeconnect/devices/{device_id}/sendnotifications")
        sendnotif_iface = dbus.Interface(sendnotif_obj, "org.kde.kdeconnect.device.sendnotifications")
        prompt_id_holder[0] = str(sendnotif_iface.sendPrompt(args.title, args.body, flattened_actions))
        sent = True
    except Exception:
        # Fallback to org.freedesktop.Notifications.Notify with hints
        try:
            notif_obj = bus.get_object("org.freedesktop.Notifications", "/org/freedesktop/Notifications")
            notif_iface = dbus.Interface(notif_obj, "org.freedesktop.Notifications")
            hints = {"urgency": dbus.Byte(2), "x-kdeconnect-prompt": dbus.Boolean(True)}
            nid = notif_iface.Notify(
                args.title,
                dbus.UInt32(0),
                "security-high",
                args.title,
                args.body,
                flattened_actions,
                hints,
                dbus.Int32(args.timeout * 1000)
            )
            prompt_id_holder[0] = str(nid)
            sent = True
        except Exception as e2:
            sys.stderr.write(f"Failed to send prompt via D-Bus: {e2}\n")
            return 3

    if not sent:
        return 3

    # Setup timeout
    def on_timeout():
        result["timed_out"] = True
        loop.quit()
        return False

    GLib.timeout_add_seconds(args.timeout, on_timeout)

    try:
        loop.run()
    except KeyboardInterrupt:
        return 130

    if result["timed_out"]:
        sys.stderr.write("Prompt timed out waiting for phone response.\n")
        return 4

    if result["action"]:
        print(result["action"])
        return 0

    return 5


if __name__ == "__main__":
    sys.exit(main())
